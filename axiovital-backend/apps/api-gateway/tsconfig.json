{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "paths": {
      "@axiovital/database": ["../../packages/database/src"],
      "@axiovital/common": ["../../packages/common/src"],
      "@axiovital/auth": ["../../packages/auth/src"],
      "@axiovital/logger": ["../../packages/logger/src"],
      "@axiovital/events": ["../../packages/events/src"],
      "@axiovital/storage": ["../../packages/storage/src"],
      "@axiovital/ai": ["../../packages/ai/src"],
      "@axiovital/fhir": ["../../packages/fhir/src"],
      "@axiovital/module-patient": ["../../modules/patient/src"],
      "@axiovital/module-doctor": ["../../modules/doctor/src"],
      "@axiovital/module-appointment": ["../../modules/appointment/src"],
      "@axiovital/module-admission": ["../../modules/admission/src"],
      "@axiovital/module-emergency": ["../../modules/emergency/src"],
      "@axiovital/module-laboratory": ["../../modules/laboratory/src"],
      "@axiovital/module-radiology": ["../../modules/radiology/src"],
      "@axiovital/module-pharmacy": ["../../modules/pharmacy/src"],
      "@axiovital/module-inventory": ["../../modules/inventory/src"],
      "@axiovital/module-billing": ["../../modules/billing/src"],
      "@axiovital/module-notification": ["../../modules/notification/src"],
      "@axiovital/module-messaging": ["../../modules/messaging/src"],
      "@axiovital/module-consent": ["../../modules/consent/src"],
      "@axiovital/module-analytics": ["../../modules/analytics/src"],
      "@modules/*": ["../../modules/*/src"]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/*/src/**/*",
    "../../modules/*/src/**/*"
  ],
  "exclude": ["node_modules", "dist", "test"]
}
