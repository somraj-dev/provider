// ============================================
// AxioVital Healthcare OS — Prisma Schema
// Phase 1-13: Foundation + Auth + Patient + Doctor + Appointment + Admission + Emergency + Lab + Radiology + Pharmacy + Billing + AI + Messaging & Notifications + Consent & Data Privacy
// ============================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp"), pgcrypto, pg_trgm]
}

// ============================================
// ENUMS
// ============================================

