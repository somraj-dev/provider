  name        String    @db.VarChar(200)
  code        String    @db.VarChar(50)
  headOfDept  String?   @map("head_of_dept") @db.VarChar(200)
  phone       String?   @db.VarChar(50)
  isActive    Boolean   @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility    Facility? @relation(fields: [facilityId], references: [id])
  wards       Ward[]
  appointments Appointment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([facilityId])
  @@map("departments")
}

model Ward {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  departmentId  String?     @map("department_id") @db.Uuid
  name          String      @db.VarChar(200)
  code          String      @db.VarChar(50)
  floor         String?     @db.VarChar(20)
  totalBeds     Int         @default(0) @map("total_beds")
  isActive      Boolean     @default(true) @map("is_active")

  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department    Department? @relation(fields: [departmentId], references: [id])
  beds          Bed[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([departmentId])
  @@map("wards")
}

// ============================================
// ENCOUNTER (Visit Tracking)
// ============================================

model Encounter {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  patientId       String          @map("patient_id") @db.Uuid
  admissionId     String?         @unique @map("admission_id") @db.Uuid

  encounterNumber String          @map("encounter_number") @db.VarChar(50)
  type            EncounterType   @default(INPATIENT)
  status          EncounterStatus @default(PRE_ADMISSION)

  startDate       DateTime        @default(now()) @map("start_date")
  endDate         DateTime?       @map("end_date")

  chiefComplaint  String?         @map("chief_complaint") @db.VarChar(500)
  referredBy      String?         @map("referred_by") @db.VarChar(200)
  referringDoctor String?         @map("referring_doctor") @db.VarChar(200)

  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admission       Admission?      @relation("AdmissionEncounter", fields: [admissionId], references: [id])

  @@unique([tenantId, encounterNumber])
  @@index([tenantId])
  @@index([patientId])
  @@index([status])
  @@index([startDate])
  @@map("encounters")
}

// ============================================
// BED ASSIGNMENT HISTORY
// ============================================

model BedAssignment {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admissionId  String     @map("admission_id") @db.Uuid
  bedId        String     @map("bed_id") @db.Uuid
  assignedAt   DateTime   @default(now()) @map("assigned_at")
  releasedAt   DateTime?  @map("released_at")
  reason       String?    @db.VarChar(200)

  admission    Admission  @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  bed          Bed        @relation(fields: [bedId], references: [id])

  @@index([admissionId])
  @@index([bedId])
  @@index([assignedAt])
  @@map("bed_assignments")
}

// ============================================
// MRN SEQUENCE (Collision-safe)
// ============================================

model MrnSequence {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  prefix      String   @default("MRN") @db.VarChar(20)
  lastValue   Int      @default(0) @map("last_value")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, prefix])
  @@map("mrn_sequences")
}

// ============================================
// TRANSACTIONAL OUTBOX (Event Delivery)
// ============================================

model OutboxEvent {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType       String            @map("event_type") @db.VarChar(200)
  aggregateType   String            @map("aggregate_type") @db.VarChar(100)
  aggregateId     String            @map("aggregate_id") @db.VarChar(255)
  tenantId        String            @map("tenant_id") @db.VarChar(255)
  payload         Json
  status          OutboxEventStatus @default(PENDING)
  retryCount      Int               @default(0) @map("retry_count")
  lastError       String?           @map("last_error") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  publishedAt     DateTime?         @map("published_at")

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@index([tenantId])
  @@map("outbox_events")
}

// ============================================
// SCHEDULING DOMAIN (Phase 4 Extended)
// ============================================

model AppointmentTypeConfig {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  code            String        @db.VarChar(50)
  name            String        @db.VarChar(200)
  durationMinutes Int           @map("duration_minutes")
  preBufferMin    Int           @default(0) @map("pre_buffer_min")
  postBufferMin   Int           @default(0) @map("post_buffer_min")
  color           String?       @db.VarChar(7)
  isActive        Boolean       @default(true) @map("is_active")
  sortOrder       Int           @default(0) @map("sort_order")

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("appointment_type_configs")
}

model ScheduleTemplate {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  doctorId           String                 @map("doctor_id") @db.Uuid
  facilityId         String?                @map("facility_id") @db.Uuid
  departmentId       String?                @map("department_id") @db.Uuid
  name               String                 @db.VarChar(200)
  effectiveFrom      DateTime               @map("effective_from")
  effectiveTo        DateTime?              @map("effective_to")
  slotGranularityMin Int                    @default(15) @map("slot_granularity_min")
  isActive           Boolean                @default(true) @map("is_active")

  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctor             Doctor                 @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  rules              ScheduleTemplateRule[]

  @@index([doctorId, effectiveFrom, effectiveTo])
  @@index([tenantId])
  @@map("schedule_templates")
}

model ScheduleTemplateRule {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String           @map("template_id") @db.Uuid
  dayOfWeek  DayOfWeek        @map("day_of_week")
  startTime  String           @map("start_time") @db.VarChar(5)
  endTime    String           @map("end_time") @db.VarChar(5)

  createdAt  DateTime         @default(now()) @map("created_at")

  template   ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("schedule_template_rules")
}

model ScheduleOverride {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String               @map("tenant_id") @db.Uuid
  doctorId  String               @map("doctor_id") @db.Uuid
  date      DateTime             @db.Date
  startTime String               @map("start_time") @db.VarChar(5)
  endTime   String               @map("end_time") @db.VarChar(5)
  type      ScheduleOverrideType
  reason    String?              @db.VarChar(500)
  createdBy String?              @map("created_by") @db.Uuid

  createdAt DateTime             @default(now()) @map("created_at")

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctor    Doctor               @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, date])
  @@index([tenantId])
  @@map("schedule_overrides")
}

model PractitionerLeave {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  doctorId   String      @map("doctor_id") @db.Uuid
  leaveType  LeaveType   @map("leave_type")
  startDate  DateTime    @map("start_date") @db.Date
  endDate    DateTime    @map("end_date") @db.Date
  startTime  String?     @map("start_time") @db.VarChar(5)
  endTime    String?     @map("end_time") @db.VarChar(5)
  status     LeaveStatus @default(PENDING)
  reason     String?     @db.VarChar(500)
  approvedBy String?     @map("approved_by") @db.Uuid
  approvedAt DateTime?   @map("approved_at")

  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctor     Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startDate, endDate])
  @@index([tenantId])
  @@map("practitioner_leaves")
}

model AppointmentHold {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  doctorId  String     @map("doctor_id") @db.Uuid
  startTime DateTime   @map("start_time")
  endTime   DateTime   @map("end_time")
  heldBy    String     @map("held_by") @db.Uuid
  status    HoldStatus @default(ACTIVE)
  expiresAt DateTime   @map("expires_at")
  token     String     @unique @db.VarChar(100)

  createdAt DateTime   @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctor    Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startTime, endTime])
  @@index([status, expiresAt])
  @@index([tenantId])
  @@map("appointment_holds")
}

model AppointmentStatusHistory {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String             @map("appointment_id") @db.Uuid
  fromStatus    AppointmentStatus? @map("from_status")
  toStatus      AppointmentStatus  @map("to_status")
  reason        String?            @db.VarChar(500)
  changedBy     String             @map("changed_by") @db.Uuid
  metadata      Json?              @default("{}")

  createdAt     DateTime           @default(now()) @map("created_at")

  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_status_history")
}

model AppointmentRequest {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                   @map("tenant_id") @db.Uuid
  appointmentId     String?                  @map("appointment_id") @db.Uuid
  patientId         String                   @map("patient_id") @db.Uuid
  requestType       AppointmentRequestType   @map("request_type")
  status            AppointmentRequestStatus @default(PENDING)
  priority          String                   @default("NORMAL") @db.VarChar(20)
  reason            String?                  @db.VarChar(500)
  notes             String?                  @db.Text
  requestedBy       String                   @map("requested_by") @db.Uuid
  reviewedBy        String?                  @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?                @map("reviewed_at")
  requestedNewStart DateTime?                @map("requested_new_start")

  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment       Appointment?             @relation(fields: [appointmentId], references: [id])
  patient           Patient                  @relation(fields: [patientId], references: [id])

  @@index([tenantId, status])
  @@index([appointmentId])
  @@index([patientId])
  @@map("appointment_requests")
}

model CalendarException {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  facilityId   String?  @map("facility_id") @db.Uuid
  departmentId String?  @map("department_id") @db.Uuid
  date         DateTime @db.Date
  name         String   @db.VarChar(200)
  isFullDay    Boolean  @default(true) @map("is_full_day")
  startTime    String?  @map("start_time") @db.VarChar(5)
  endTime      String?  @map("end_time") @db.VarChar(5)

  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@map("calendar_exceptions")
}

model SchedulingPolicy {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  facilityId             String?  @map("facility_id") @db.Uuid
  departmentId           String?  @map("department_id") @db.Uuid
  slotGranularityMin     Int      @default(15) @map("slot_granularity_min")
  maxAdvanceBookingDays  Int      @default(90) @map("max_advance_booking_days")
  minAdvanceBookingHours Int      @default(1) @map("min_advance_booking_hours")
  holdDurationSeconds    Int      @default(300) @map("hold_duration_seconds")
  allowDoubleBooking     Boolean  @default(false) @map("allow_double_booking")
  requireConfirmation    Boolean  @default(false) @map("require_confirmation")

  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("scheduling_policies")
}
