// ============================================
// TENANT (Multi-Tenancy Foundation)
// ============================================

model Tenant {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String       @db.VarChar(255)
  slug        String       @unique @db.VarChar(100)
  type        TenantType
  status      TenantStatus @default(PENDING_SETUP)

  // Contact & location
  email       String?      @db.VarChar(255)
  phone       String?      @db.VarChar(50)
  address     String?      @db.Text
  city        String?      @db.VarChar(100)
  state       String?      @db.VarChar(100)
  country     String       @default("IN") @db.VarChar(10)
  postalCode  String?      @map("postal_code") @db.VarChar(20)

  // Licensing
  licenseKey     String?   @unique @map("license_key") @db.VarChar(255)
  licenseExpiry  DateTime? @map("license_expiry")
  maxUsers       Int       @default(50) @map("max_users")

  // Configuration
  settings    Json?        @default("{}")
  timezone    String       @default("Asia/Kolkata") @db.VarChar(50)

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  users       User[]
  roles       Role[]
  auditLogs   AuditLog[]
  fileMetadata FileMetadata[]
  patients    Patient[]
  doctors     Doctor[]
  appointments Appointment[]
  beds        Bed[]
  admissions  Admission[]
  triages     EmergencyTriage[]
  labTestCatalogs LabTestCatalog[]
  labOrders   LabOrder[]
  imagingOrders ImagingOrder[]
  inventoryItems InventoryItem[]
  prescriptions Prescription[]
  invoices    Invoice[]
  insuranceClaims InsuranceClaim[]
  aiConsultations AiConsultation[]
  notifications Notification[]
  messages    Message[]
  consents    PatientConsent[]
  departments Department[]
  wards       Ward[]
  facilities  Facility[]
  encounters  Encounter[]
  mrnSequences MrnSequence[]
  appointmentTypeConfigs AppointmentTypeConfig[]
  scheduleTemplates ScheduleTemplate[]
  scheduleOverrides ScheduleOverride[]
  practitionerLeaves PractitionerLeave[]
  appointmentHolds AppointmentHold[]
  appointmentRequests AppointmentRequest[]
  calendarExceptions CalendarException[]
  schedulingPolicies SchedulingPolicy[]

  @@map("tenants")
}

// ============================================
// USER (Identity)
// ============================================

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  email           String     @db.VarChar(255)
  passwordHash    String     @map("password_hash") @db.VarChar(512)

  // Profile
  firstName       String     @map("first_name") @db.VarChar(100)
  lastName        String     @map("last_name") @db.VarChar(100)
  displayName     String?    @map("display_name") @db.VarChar(200)
  phone           String?    @db.VarChar(50)
  avatarUrl       String?    @map("avatar_url") @db.VarChar(500)

  // Status
  status          UserStatus @default(PENDING_VERIFICATION)

  // Security
  mfaEnabled      Boolean    @default(false) @map("mfa_enabled")
  mfaSecret       String?    @map("mfa_secret") @db.VarChar(255)
  passwordChangedAt DateTime? @map("password_changed_at")
  failedLoginAttempts Int    @default(0) @map("failed_login_attempts")
  lockedUntil     DateTime?  @map("locked_until")
  lastLoginAt     DateTime?  @map("last_login_at")
  lastLoginIp     String?    @map("last_login_ip") @db.VarChar(45)

  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // Relations
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole2[]
  refreshTokens   RefreshToken[]
  sessions        Session[]
  auditLogs       AuditLog[]
  uploadedFiles   FileMetadata[] @relation("FileUploader")
  doctorProfile   Doctor?
  performedTriages EmergencyTriage[] @relation("TriagedBy")
  labResultsRecorded LabResult[] @relation("PerformingTech")
  dispensedPrescriptions Prescription[] @relation("DispensingPharmacist")
  processedPayments Payment[] @relation("PaymentProcessor")
  notifications Notification[] @relation("ReceivedNotification")
  sentMessages    Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageRecipient")
  consentsGranted PatientConsent[] @relation("GrantedToUser")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([status])
  @@map("users")
}

// ============================================
// RBAC & AUTH
// ============================================

model Role {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  name        String       @db.VarChar(100)
  description String?      @db.VarChar(500)
  systemRole  UserRole     @map("system_role")
  isActive    Boolean      @default(true) @map("is_active")

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserRole2[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([systemRole])
  @@map("roles")
}

model RolePermission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId      String           @map("role_id") @db.Uuid
  action      PermissionAction
  resource    ResourceType
  conditions  Json?            @default("{}")

  createdAt   DateTime         @default(now()) @map("created_at")

  role        Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, action, resource])
  @@index([roleId])
  @@map("role_permissions")
}

model UserRole2 {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  roleId      String     @map("role_id") @db.Uuid
  assignedBy  String?    @map("assigned_by") @db.Uuid
  assignedAt  DateTime   @default(now()) @map("assigned_at")

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  tokenHash   String     @unique @map("token_hash") @db.VarChar(512)
  familyId    String     @map("family_id") @db.VarChar(255)
  expiresAt   DateTime   @map("expires_at")
  isRevoked   Boolean    @default(false) @map("is_revoked")
  revokedAt   DateTime?  @map("revoked_at")
  replacedBy  String?    @map("replaced_by") @db.VarChar(255)

  userAgent   String?    @map("user_agent") @db.VarChar(500)
  ipAddress   String?    @map("ip_address") @db.VarChar(45)

  createdAt   DateTime   @default(now()) @map("created_at")

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Session {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  deviceName  String?    @map("device_name") @db.VarChar(255)
  userAgent   String?    @map("user_agent") @db.VarChar(500)
  ipAddress   String     @map("ip_address") @db.VarChar(45)
  isActive    Boolean    @default(true) @map("is_active")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  expiresAt   DateTime   @map("expires_at")

  createdAt   DateTime   @default(now()) @map("created_at")

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================
// PATIENT DOMAIN (Phase 3)
// ============================================

model Patient {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  mrn             String         @map("mrn") @db.VarChar(50)
  nationalId      String?        @map("national_id") @db.VarChar(100)

  // Name fields (expanded to match frontend Admit Patient form)
  title           String?        @db.VarChar(20)
  firstName       String         @map("first_name") @db.VarChar(100)
  middleName      String?        @map("middle_name") @db.VarChar(100)
  lastName        String         @map("last_name") @db.VarChar(100)

  dateOfBirth     DateTime       @map("date_of_birth")
  gender          Gender
  bloodGroup      BloodGroup     @default(UNKNOWN) @map("blood_group")
  maritalStatus   MaritalStatus  @default(SINGLE) @map("marital_status")

  // Demographics (from frontend admit form)
  nationality     String?        @db.VarChar(100)
  religion        String?        @db.VarChar(100)
  language        String?        @db.VarChar(100)

  // Contact
  email           String?        @db.VarChar(255)
  phone           String         @db.VarChar(50)
  alternateMobile String?        @map("alternate_mobile") @db.VarChar(50)

  // Address
  addressLine1    String?        @map("address_line_1") @db.VarChar(500)
  addressLine2    String?        @map("address_line_2") @db.VarChar(500)
  landmark        String?        @db.VarChar(200)
  city            String?        @db.VarChar(100)
  state           String?        @db.VarChar(100)
  country         String         @default("IN") @db.VarChar(10)
  postalCode      String?        @map("postal_code") @db.VarChar(20)

  // Emergency Contact
  emergencyContactName  String?  @map("emergency_contact_name") @db.VarChar(200)
  emergencyContactPhone String?  @map("emergency_contact_phone") @db.VarChar(50)
  emergencyContactRel   String?  @map("emergency_contact_rel") @db.VarChar(100)

  primaryDoctorId String?        @map("primary_doctor_id") @db.Uuid

  // Optimistic concurrency
  version         Int            @default(1)

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryDoctor   Doctor?        @relation("PrimaryDoctor", fields: [primaryDoctorId], references: [id])
  allergies       PatientAllergy[]
  vitals          PatientVital[]
  conditions      PatientCondition[]
  appointments    Appointment[]
  admissions      Admission[]
  encounters      Encounter[]
  triages         EmergencyTriage[]
  labOrders       LabOrder[]
  imagingOrders   ImagingOrder[]
  prescriptions   Prescription[]
  invoices        Invoice[]
  insuranceClaims InsuranceClaim[]
  aiConsultations AiConsultation[]
  messages        Message[]
  consents        PatientConsent[]
  appointmentRequests AppointmentRequest[]

  @@unique([tenantId, mrn])
  @@index([tenantId])
  @@index([mrn])
  @@index([nationalId])
  @@index([firstName, lastName])
  @@index([phone])
  @@map("patients")
}

model PatientAllergy {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId   String          @map("patient_id") @db.Uuid
  substance   String          @db.VarChar(200)
  reaction    String?         @db.VarChar(500)
  severity    AllergySeverity @default(MODERATE)
  isCritical  Boolean         @default(false) @map("is_critical")
  recordedAt  DateTime        @default(now()) @map("recorded_at")

  patient     Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_allergies")
}

model PatientVital {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  systolicBp      Int?     @map("systolic_bp")
  diastolicBp     Int?     @map("diastolic_bp")
  heartRate       Int?     @map("heart_rate")
  temperature     Float?
  respiratoryRate Int?     @map("respiratory_rate")
  oxygenSat       Float?   @map("oxygen_sat")
  heightCm        Float?   @map("height_cm")
  weightKg        Float?   @map("weight_kg")
  bmi             Float?
  recordedAt      DateTime @default(now()) @map("recorded_at")
  recordedBy      String?  @map("recorded_by") @db.Uuid

  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([recordedAt])
  @@map("patient_vitals")
}

model PatientCondition {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  icdCode     String?  @map("icd_code") @db.VarChar(20)
  name        String   @db.VarChar(255)
  onsetAge    Int?     @map("onset_age")
  isActive    Boolean  @default(true) @map("is_active")
  diagnosedAt DateTime @default(now()) @map("diagnosed_at")

  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_conditions")
}

// ============================================
// DOCTOR DOMAIN (Phase 3)
// ============================================

model Doctor {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  userId          String               @unique @map("user_id") @db.Uuid
  licenseNumber   String               @unique @map("license_number") @db.VarChar(100)
  npi             String?              @map("npi") @db.VarChar(50)
  specialization  DoctorSpecialization
  subSpecialty    String?              @map("sub_specialty") @db.VarChar(200)
  qualifications  String[]
  department      String               @db.VarChar(100)
  consultationFee Decimal              @map("consultation_fee") @db.Decimal(10, 2)
  status          DoctorStatus         @default(ACTIVE)

  schedule        Json?                @default("{}")

  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryPatients Patient[]            @relation("PrimaryDoctor")
  appointments    Appointment[]
  admissions      Admission[]          @relation("AdmittingDoctor")
  orderedLabOrders LabOrder[]          @relation("OrderingDoctor")
  orderedImagingOrders ImagingOrder[]  @relation("ImagingOrderingDoctor")
  performedImagingStudies ImagingStudy[] @relation("PerformingRadiologist")
  prescriptions   Prescription[]       @relation("PrescribingDoctor")
  aiConsultations AiConsultation[]
  scheduleTemplates ScheduleTemplate[]
  scheduleOverrides ScheduleOverride[]
  leaves          PractitionerLeave[]
  holds           AppointmentHold[]

  @@index([tenantId])
  @@index([specialization])
  @@index([department])
  @@map("doctors")
}

// ============================================
// APPOINTMENT DOMAIN (Phase 4)
// ============================================

model Appointment {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  patientId          String            @map("patient_id") @db.Uuid
  doctorId           String            @map("doctor_id") @db.Uuid
  facilityId         String?           @map("facility_id") @db.Uuid
  departmentId       String?           @map("department_id") @db.Uuid
  appointmentTypeId  String?           @map("appointment_type_id") @db.Uuid

  status             AppointmentStatus @default(SCHEDULED)
  type               AppointmentType   @default(CONSULTATION)

  startTime          DateTime          @map("start_time")
  endTime            DateTime          @map("end_time")
  durationMinutes    Int               @default(30) @map("duration_minutes")

  reason             String            @db.VarChar(500)
  notes              String?           @db.Text
  cancellationReason String?           @map("cancellation_reason") @db.VarChar(500)
  telehealthLink     String?           @map("telehealth_link") @db.VarChar(500)

  version            Int               @default(1)

  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor             Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  facility           Facility?         @relation(fields: [facilityId], references: [id])
  department         Department?       @relation(fields: [departmentId], references: [id])
  appointmentTypeConfig AppointmentTypeConfig? @relation(fields: [appointmentTypeId], references: [id])
  statusHistory      AppointmentStatusHistory[]
  requests           AppointmentRequest[]

  @@index([tenantId])
  @@index([patientId])
  @@index([doctorId])
  @@index([facilityId])
