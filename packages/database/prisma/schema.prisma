// ADMISSION & INPATIENT DOMAIN (Phase 5)
// ============================================

model Bed {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  wardId      String?     @map("ward_id") @db.Uuid
  bedNumber   String      @map("bed_number") @db.VarChar(50)
  ward        String      @db.VarChar(100)
  roomNumber  String?     @map("room_number") @db.VarChar(50)
  floor       String?     @db.VarChar(20)
  type        BedType     @default(GENERAL_WARD)
  status      BedStatus   @default(AVAILABLE)
  dailyRate   Decimal     @map("daily_rate") @db.Decimal(10, 2)

  // Optimistic concurrency
  version     Int         @default(1)

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wardEntity  Ward?       @relation(fields: [wardId], references: [id])
  admissions  Admission[]
  bedAssignments BedAssignment[]

  @@unique([tenantId, bedNumber])
  @@index([tenantId])
  @@index([wardId])
  @@index([status])
  @@index([ward])
  @@map("beds")
}

model Admission {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  patientId          String            @map("patient_id") @db.Uuid
  doctorId           String            @map("doctor_id") @db.Uuid
  bedId              String?           @map("bed_id") @db.Uuid

  status             AdmissionStatus   @default(ADMITTED)
  priority           AdmissionPriority @default(ROUTINE)

  admissionDate      DateTime          @default(now()) @map("admission_date")
  dischargeDate      DateTime?         @map("discharge_date")

  admittingDiagnosis String            @map("admitting_diagnosis") @db.VarChar(500)
  dischargeSummary   String?           @map("discharge_summary") @db.Text

  // Optimistic concurrency
  version            Int               @default(1)

  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor             Doctor            @relation("AdmittingDoctor", fields: [doctorId], references: [id])
  bed                Bed?              @relation(fields: [bedId], references: [id], onDelete: SetNull)
  encounter          Encounter?        @relation("AdmissionEncounter")
  bedAssignments     BedAssignment[]

  @@index([tenantId])
  @@index([patientId])
  @@index([doctorId])
  @@index([bedId])
  @@index([status])
  @@map("admissions")
}

