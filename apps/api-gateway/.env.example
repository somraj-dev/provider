# ============================================
# AxioVital Backend Environment Configuration
# Copy to .env and configure for local development
# ============================================

# ---- General ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_NAME=axiovital-backend
APP_VERSION=0.1.0

# ---- Database (PostgreSQL + pgvector) ----
DATABASE_URL=postgresql://axiovital_user:change-me@localhost:5432/axiovital

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- OpenSearch ----
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# ---- MinIO (S3-compatible Object Storage) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=axiovital_minio
MINIO_SECRET_KEY=change-me-in-production
MINIO_USE_SSL=false
MINIO_BUCKET_MEDICAL_IMAGES=medical-images
MINIO_BUCKET_CLINICAL_DOCUMENTS=clinical-documents
MINIO_BUCKET_LAB_REPORTS=lab-reports
MINIO_BUCKET_PRESCRIPTIONS=prescriptions
MINIO_BUCKET_PATIENT_MEDIA=patient-media

# ---- Kafka / Redpanda ----
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=axiovital-backend
KAFKA_CONSUMER_GROUP=axiovital-backend-group

# ---- JWT ----
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=3600
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRATION=604800

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- AI Service ----
AI_SERVICE_URL=http://localhost:8000

# ---- Logging ----
LOG_LEVEL=debug
